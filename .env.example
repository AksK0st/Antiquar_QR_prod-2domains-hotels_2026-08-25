APP_ENV=development
SQL_ECHO=false

POSTGRES_DB=antique_hotel
POSTGRES_USER=antique
POSTGRES_PASSWORD=change_me

MINIO_ROOT_USER=change_me
MINIO_ROOT_PASSWORD=change_me
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=antique-images
MINIO_SECURE=false

PUBLIC_BASE_URL=http://localhost:5173

ADMIN_SESSION_TTL_HOURS=12
ADMIN_IMAGE_MAX_BYTES=15728640
ADMIN_IMAGE_MAX_PIXELS=40000000
ADMIN_LOGIN_RATE_LIMIT_ATTEMPTS=5
ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
ADMIN_LOGIN_BLOCK_SECONDS=300
LOG_LEVEL=INFO
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5
POSTGRES_POOL_TIMEOUT_SECONDS=10
POSTGRES_STATEMENT_TIMEOUT_MS=15000
MINIO_CONNECT_TIMEOUT_SECONDS=3
MINIO_READ_TIMEOUT_SECONDS=10
