# Copy to .env.production and replace EVERY secret/value before deployment.
DOMAIN=antiquar.example.com
# Set an immutable release identifier before deployment (git SHA/date tag).
RELEASE_TAG=
LOG_LEVEL=INFO

POSTGRES_DB=antique_hotel
POSTGRES_USER=antique_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD

# Root credentials are used only by the MinIO bootstrap job.
MINIO_ROOT_USER=antiquar_storage_admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ROOT_PASSWORD

# Least-privileged credentials used by the FastAPI application.
MINIO_APP_USER=antiquar_app
MINIO_APP_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_APP_PASSWORD
MINIO_BUCKET=antique-images

ADMIN_SESSION_TTL_HOURS=12
ADMIN_IMAGE_MAX_BYTES=15728640
ADMIN_IMAGE_MAX_PIXELS=40000000
ADMIN_LOGIN_RATE_LIMIT_ATTEMPTS=5
ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
ADMIN_LOGIN_BLOCK_SECONDS=300

POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT_SECONDS=10
POSTGRES_STATEMENT_TIMEOUT_MS=15000
MINIO_CONNECT_TIMEOUT_SECONDS=3
MINIO_READ_TIMEOUT_SECONDS=10

# Absolute path on a separate/off-host mounted filesystem.
BACKUP_DIR=
BACKUP_APPLY_RETENTION=1
